set -eu
fail() {
    code="$1"
    echo "NVX-L3-L4-PROTOCOLS-FAIL code=$code"
    nvx-exit "$code"
    exit "$code"
}

probe_tcp() {
    if response=$(wget -T 2 -qO- "http://@GATEWAY_IPV4@:$2/$1" 2>/dev/null); then
        if [ "$response" = "NVX-EGRESS-PROBE-$1" ]; then
            echo reached
        else
            echo unexpected
        fi
    else
        echo blocked
    fi >"/tmp/nvx-egress-$1"
}

# Only the host can observe UDP delivery. A denied flow may return 1; sender
# execution failures must not pass.
probe_udp() {
    status=0
    printf 'NVX-EGRESS-PROBE-%s' "$1" |
        nc -u -w 1 @GATEWAY_IPV4@ "$2" >/dev/null 2>&1 || status=$?
    case "$status" in
    0 | 1) echo sent ;;
    *) echo "failed-$status" ;;
    esac >"/tmp/nvx-egress-$1"
}

probe_icmp() {
    if ping -c 1 -W 2 @GATEWAY_IPV4@ >/dev/null 2>&1; then
        echo reached
    else
        echo blocked
    fi >/tmp/nvx-egress-icmp
}

rm -f /tmp/nvx-egress-*
probe_tcp tcp-named @NAMED_PORT@ &
probe_tcp tcp-other @OTHER_PORT@ &
probe_udp udp-named @NAMED_PORT@ &
probe_udp udp-other @OTHER_PORT@ &
probe_icmp &
wait
for probe in tcp-named tcp-other udp-named udp-other icmp; do
    [ -s "/tmp/nvx-egress-$probe" ] || fail 70
    echo "NVX-L3-L4-PROBE $probe=$(cat "/tmp/nvx-egress-$probe")"
done

echo NVX-L3-L4-EGRESS-PROTOCOLS-OK
nvx-exit 0
