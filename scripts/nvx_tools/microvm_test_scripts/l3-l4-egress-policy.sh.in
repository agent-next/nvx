set -eu
fail() {
    code="$1"
    echo "NVX-L3-L4-EGRESS-FAIL code=$code"
    nvx-exit "$code"
    exit "$code"
}

allowed=$(wget -T 5 -qO- http://@GATEWAY_IPV4@:@TCP_START@/allowed) ||
    fail 80
[ "$allowed" = NVX-L3-L4-TCP-ALLOW-START ] || fail 81

allowed=$(wget -T 5 -qO- http://@GATEWAY_IPV4@:@TCP_END@/allowed) ||
    fail 82
[ "$allowed" = NVX-L3-L4-TCP-ALLOW-END ] || fail 83

for port in @TCP_ADJACENT_LOW@ @TCP_DENIED@ @TCP_ADJACENT_HIGH@; do
    if wget -T 2 -qO /dev/null "http://@GATEWAY_IPV4@:$port/denied"; then
        fail 84
    fi
done

printf 'NVX-L3-L4-UDP-ALLOW-START' |
    nc -u -w 1 @GATEWAY_IPV4@ @UDP_START@ || fail 85
printf 'NVX-L3-L4-UDP-ALLOW-END' |
    nc -u -w 1 @GATEWAY_IPV4@ @UDP_END@ || fail 86
for port in @UDP_ADJACENT_LOW@ @UDP_DENIED@ @UDP_ADJACENT_HIGH@; do
    printf 'NVX-L3-L4-UDP-DENY' |
        nc -u -w 1 @GATEWAY_IPV4@ "$port" || true
done
sleep 1

echo NVX-L3-L4-EGRESS-OK
nvx-exit 0
